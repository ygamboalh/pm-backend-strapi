{
  "kind": "collectionType",
  "collectionName": "encargos",
  "info": {
    "singularName": "encargo",
    "pluralName": "encargos",
    "displayName": "Encargo"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
